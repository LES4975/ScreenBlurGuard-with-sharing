<Window x:Class="ScreenBlurGuard.Overlay.RegionSelectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        Cursor="Cross"
        Background="#40000000"
        WindowStartupLocation="Manual">
    <Grid>
        <TextBlock Text="드래그해서 블러 영역을 선택하세요. (Esc: 취소)"
                   Foreground="White" FontSize="16" FontWeight="Bold"
                   HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,24,0,0" />
        <Canvas x:Name="SelectionCanvas">
            <Rectangle x:Name="SelectionRect"
                       Stroke="#FF3A8BFF" StrokeThickness="2" StrokeDashArray="4 2"
                       Fill="#403A8BFF" Visibility="Collapsed" />
        </Canvas>
    </Grid>
</Window>
