<Window x:Class="ScreenBlurGuard.Overlay.MirrorPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="공유용 미러 - ScreenBlurGuard"
        SizeToContent="WidthAndHeight"
        ResizeMode="NoResize"
        Background="Black">
    <Canvas x:Name="RootCanvas">
        <Image x:Name="MirrorImage" Stretch="None" />
        <!--
          BlurredMirrorContainer holds the clip geometry (which regions are visible); the
          Effect lives on the Image INSIDE it. Putting both Clip and Effect on the same
          element would blur an already-clipped (mostly transparent) bitmap instead of the
          full frame, producing faded edges instead of a clean blurred patch.
        -->
        <Canvas x:Name="BlurredMirrorContainer" IsHitTestVisible="False">
            <Image x:Name="BlurredMirrorImage" Stretch="None" />
        </Canvas>
    </Canvas>
</Window>
