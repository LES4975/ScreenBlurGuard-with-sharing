<Window x:Class="ScreenBlurGuard.Overlay.MirrorPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="공유용 미러 - ScreenBlurGuard"
        SizeToContent="WidthAndHeight"
        ResizeMode="NoResize"
        Background="Black">
    <Canvas x:Name="RootCanvas">
        <Image x:Name="MirrorImage" Stretch="None" />
        <Rectangle x:Name="BlurRect">
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#FF505050" Offset="0.0" />
                    <GradientStop Color="#FF707070" Offset="0.5" />
                    <GradientStop Color="#FF505050" Offset="1.0" />
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>
    </Canvas>
</Window>
